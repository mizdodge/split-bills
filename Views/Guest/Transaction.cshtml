@model GuestBillViewModel
@{ ViewData["Title"] = L["WholeTransaction"]; var money = Model.CurrencyCode == "IDR" ? "Rp" : Model.CurrencyCode; }
<div class="page-heading compact"><div><span class="eyebrow">SplitBill · @L["GuestAccess"]</span><h1>@Model.MerchantName</h1><p>@Model.TransactionNumber · @(Model.TransactionDate?.ToString("dd MMMM yyyy") ?? "-")</p></div><span class="status large @Model.Status.ToString().ToLowerInvariant()">@L[Model.Status.ToString()]</span></div>
<div class="guest-nav">@if (Model.HasPersonalView) { <a href="/g/my-bill/@Uri.EscapeDataString(Model.Token)">@L["MyBill"]</a> }<a class="active" href="/g/transaction/@Uri.EscapeDataString(Model.Token)">@L["WholeTransaction"]</a></div>
<section class="content-card guest-card"><div class="section-head"><div><h2>@L["WholeTransaction"]</h2><p>@L["GuestReadOnlyHint"]</p></div><strong>@money @Model.GrandTotal.ToString("N2")</strong></div>
@foreach(var participant in Model.Participants){<article class="guest-participant"><div class="guest-participant-head"><strong>@participant.Name</strong><strong>@money @participant.Amount.ToString("N2")</strong></div><span class="status @participant.PaymentStatus.ToString().ToLowerInvariant()">@L[participant.PaymentStatus.ToString()]</span>@foreach(var item in participant.Items){<div class="guest-line"><span>@item.Name <small>× @item.Quantity.ToString("0.##")</small></span><strong>@money @item.Amount.ToString("N2")</strong></div>}</article>}
<div class="guest-total"><span>@L["Subtotal"]</span><strong>@money @Model.Subtotal.ToString("N2")</strong></div><div class="guest-line"><span>@L["Discount"]</span><strong>- @money @Model.Discount.ToString("N2")</strong></div><div class="guest-line"><span>@L["Tax"]</span><strong>+ @money @Model.Tax.ToString("N2")</strong></div><div class="guest-line"><span>@L["ServiceCharge"]</span><strong>+ @money @Model.ServiceCharge.ToString("N2")</strong></div><div class="guest-total"><span>@L["Total"]</span><strong>@money @Model.GrandTotal.ToString("N2")</strong></div></section>
@if(Model.ReceiptImageUrls.Count > 0){<section class="content-card"><div class="section-head"><h2>@L["ReceiptPhotos"]</h2></div><div class="guest-gallery">@foreach(var url in Model.ReceiptImageUrls){<button type="button" data-receipt-viewer data-receipt-url="@url"><img src="@url" alt="@L["ReceiptPhotos"]" loading="lazy" /></button>}</div></section>}
