@model GuestBillViewModel
@{ ViewData["Title"] = "My bill"; var money = Model.CurrencyCode == "IDR" ? "Rp" : Model.CurrencyCode; }
<div class="page-heading compact"><div><span class="eyebrow">SplitBill · @L["GuestAccess"]</span><h1>@Model.MerchantName</h1><p>@Model.TransactionNumber · @(Model.TransactionDate?.ToString("dd MMMM yyyy") ?? "-")</p></div><span class="status large @Model.Status.ToString().ToLowerInvariant()">@L[Model.Status.ToString()]</span></div>
<div class="guest-nav"><a class="active" href="/g/my-bill/@Uri.EscapeDataString(Model.Token)">@L["MyBill"]</a><a href="/g/transaction/@Uri.EscapeDataString(Model.Token)">@L["WholeTransaction"]</a></div>
<section class="content-card guest-card"><div class="section-head"><div><h2>@L["YourBillBreakdown"]</h2><p>@Model.GuestParticipantName</p></div><strong>@money @Model.Participants.Sum(x => x.Amount).ToString("N2")</strong></div>
@foreach (var participant in Model.Participants){<div class="guest-participant"><div><strong>@participant.Name</strong><span class="status @participant.PaymentStatus.ToString().ToLowerInvariant()">@L[participant.PaymentStatus.ToString()]</span></div>@foreach(var item in participant.Items){<div class="guest-line"><span>@item.Name <small>× @item.Quantity.ToString("0.##")</small></span><strong>@money @item.Amount.ToString("N2")</strong></div>}</div>}
<div class="guest-total"><span>@L["Total"]</span><strong>@money @Model.Participants.Sum(x => x.Amount).ToString("N2")</strong></div></section>
@if(Model.ReceiptImageUrls.Count > 0){<section class="content-card"><div class="section-head"><h2>@L["ReceiptPhotos"]</h2></div><div class="guest-gallery">@foreach(var url in Model.ReceiptImageUrls){<button type="button" data-receipt-viewer data-receipt-url="@url"><img src="@url" alt="@L["ReceiptPhotos"]" loading="lazy" /></button>}</div></section>}
