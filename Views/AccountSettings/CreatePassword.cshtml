@model AccountPasswordInput
@{ ViewData["Title"] = L["AccountCreatePassword"]; }
<div class="page-heading compact"><div><a class="back-link" asp-action="Index">← @L["AccountSettings"]</a><h1>@L["AccountCreatePassword"]</h1><p>@L["AccountCreatePasswordHint"]</p></div></div>
<section class="content-card account-security-confirm">
    <form asp-action="CreatePassword" method="post">
        <input type="hidden" name="RequestId" value="@Model.RequestId" />
        <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
        <p class="text-muted">@L["AccountPasswordPolicy"]</p>
        <div class="form-group"><label for="new-local-password">@L["NewPassword"]</label><input id="new-local-password" type="password" name="Password" class="form-control" required minlength="6" autocomplete="new-password" /></div>
        <div class="form-group"><label for="confirm-local-password">@L["ConfirmPassword"]</label><input id="confirm-local-password" type="password" name="ConfirmPassword" class="form-control" required minlength="6" autocomplete="new-password" /></div>
        <div class="form-actions"><a class="btn btn-light" asp-action="Index">@L["Cancel"]</a><button type="submit" class="btn btn-primary">@L["AccountCreatePassword"]</button></div>
    </form>
</section>
