@model PaymentApprovalListViewModel
@{ ViewData["Title"] = L["Approvals"]; }
<div class="page-heading"><div><span class="eyebrow">@L["Approvals"]</span><h1>@L["AwaitingConfirmation"]</h1><p>@L["CheckPaymentClaims"]</p></div></div>
<section class="content-card">
    @if (Model.Approvals.Count == 0) { <div class="empty-inline"><span>✓</span><strong>@L["NoApprovals"]</strong><p>@L["NewRequestsAppear"]</p></div> }
    else { <div class="table-responsive"><table class="app-table"><thead><tr><th>@L["Participant"]</th><th>@L["Transactions"]</th><th>@L["Amount"]</th><th>@L["Submitted"]</th><th>@L["PaymentProof"]</th><th>@L["Details"]</th></tr></thead><tbody>
        @foreach (var item in Model.Approvals) { <tr><td><strong>@item.ParticipantName</strong></td><td><strong>@item.MerchantName</strong><small>@item.TransactionNumber</small></td><td>Rp @item.Amount.ToString("N0")</td><td>@item.RequestedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@if (item.HasProof) { <button type="button" class="btn btn-sm btn-soft" data-proof-viewer data-viewer-group="proof" data-viewer-url="@Url.Action("Proof", new { id = item.ApprovalId })" data-viewer-title='@L["PaymentProof"]' aria-label='@L["ViewProof"]'>@L["ViewProof"]</button><small>@item.ProofOriginalFileName</small> } else { <span class="status unpaid">@L["MissingProof"]</span> }</td><td><div class="d-flex flex-wrap gap-2"><form asp-action="Confirm" method="post" class="m-0"><input type="hidden" name="id" value="@item.ParticipantId" /><button class="btn btn-sm btn-primary" type="submit">@L["Confirm"]</button></form><form asp-action="Reject" method="post" class="reject-payment-form"><input type="hidden" name="id" value="@item.ParticipantId" /><label class="visually-hidden" for="note-@item.ApprovalId">@L["RejectReason"]</label><textarea id="note-@item.ApprovalId" name="note" class="form-control reject-note-input" maxlength="500" required placeholder="@L["RejectReasonPlaceholder"]"></textarea><button class="btn btn-sm btn-outline-danger" type="submit">@L["Reject"]</button></form><a class="btn btn-sm btn-soft" asp-controller="Reports" asp-action="Details" asp-route-id="@item.TransactionId">@L["Report"]</a></div></td></tr> }
    </tbody></table></div> }
</section>
