@model ReportDetailsViewModel
@using Splitbill.Models
@using Splitbill.Services
@{ ViewData["Title"] = L["DetailsReport"]; var tx = Model.Transaction; }
<div class="page-heading compact"><div class="report-detail-heading"><a class="back-link" asp-action="Index">← @L["AllReports"]</a><span class="eyebrow">@L["ReportDetailEyebrow"]</span><h1>@tx.MerchantName</h1><p>@tx.TransactionNumber · @tx.EffectiveDate.ToString("dd MMMM yyyy") · @tx.UploaderName</p></div><span class="status large @tx.Status.ToString().ToLowerInvariant()">@L[tx.Status.ToString()]</span></div>
<div class="detail-grid">
    <section class="content-card bill-summary"><div><span>@L["TotalBill"]</span><strong>Rp @tx.GrandTotal.ToString("N0")</strong><small>@L["OrderItemCount", tx.Items.Count] · @L["PeopleCount", tx.Participants.Count] · @L[tx.SplitMethod.ToString()]</small></div><a class="btn btn-primary" asp-action="Export" asp-route-from="@tx.EffectiveDate.ToString("yyyy-MM-dd")" asp-route-to="@tx.EffectiveDate.ToString("yyyy-MM-dd")">@L["ExportReport"]</a></section>
    @if (tx.PickupPersonName is not null)
    {
        <section class="content-card pickup-result-card report-pickup-result-card"><div class="pickup-result-icon">★</div><div class="pickup-result-copy"><span class="eyebrow">@L["FoodPickupWinner"]</span><h2>@tx.PickupPersonName</h2><p>@L["FoodPickupWinnerHint"]</p></div><div class="pickup-result-meta">@if(tx.PickupStrategy == FoodPickupSelectionStrategy.RoundRobin){<strong>↻ @L["FoodPickupStrategyRoundRobin"]</strong><small>@L["FoodPickupSelectedByRoundRobin"]</small>}else{<strong>@tx.PickupProbability?.ToString("0.##%")</strong><small>@L["FoodPickupDrawProbability"]</small>}<small>@(tx.PickupDrawKind.HasValue ? L[$"FoodPickupDraw{tx.PickupDrawKind.Value}"] : string.Empty) · @(tx.PickupSelectedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm"))</small></div></section>
    }
    <section class="content-card"><div class="section-head"><div><h2>@L["PaymentStatusHeading"]</h2><p>@L["OneTimePerParticipant"]</p></div></div><div class="payment-list">@foreach(var person in tx.Participants){<article class="payment-person"><span class="avatar">@person.ParticipantName[0].ToString().ToUpperInvariant()</span><div><strong>@person.ParticipantName @if (person.IsPickupPerson) { <span class="pickup-inline-badge">★ @L["FoodPickupBadge"]</span> }</strong><div class="member-menu-list report-member-items">@foreach (var item in person.ItemDetails) { <div><span>@item.Name <small>× @item.Quantity.ToString("0.##")</small></span><strong>Rp @item.Amount.ToString("N0")</strong></div> }@if (person.ItemDetails.Count == 0) { <small>@person.MenuDetail</small> }</div></div><strong class="person-amount">Rp @person.AmountDue.ToString("N0")</strong><span class="status @person.PaymentStatus.ToString().ToLowerInvariant()">@L[person.PaymentStatus.ToString()]</span></article>}</div></section>
    <section class="content-card"><div class="section-head"><div><h2>@L["ReceiptDetails"]</h2><p>@L["ReceiptMenuAndCharges"]</p></div></div><div class="compact-items">@foreach(var item in tx.Items){<div><span>@item.Name <small>@item.Quantity × Rp @item.UnitPrice.ToString("N0")</small></span><strong>Rp @item.TotalPrice.ToString("N0")</strong></div>}</div><div class="compact-totals"><div><span>@L["Subtotal"]</span><strong>Rp @tx.Subtotal.ToString("N0")</strong></div>@foreach(var charge in tx.Charges){<div><span>@charge.Label</span><strong>@(charge.Operation == ChargeOperation.Subtract ? "-" : "+") Rp @charge.Amount.ToString("N0")</strong></div>}<div><span>@L["Total"]</span><strong>Rp @tx.GrandTotal.ToString("N0")</strong></div></div></section>
</div>
