@model Splitbill.ViewModels.AdminCurrencyViewModel
@{ ViewData["Title"] = L["CurrencySettings"]; }
<div class="page-heading"><div><span class="eyebrow">@L["Admin"]</span><h1>@L["CurrencySettings"]</h1><p>@L["CurrencySettingsDescription"]</p></div></div>
<form method="post" class="content-card" asp-action="Save">
    <div asp-validation-summary="All" class="validation-summary" role="alert"></div>
    <div class="section-head"><div><h2>@L["DefaultCurrency"]</h2><p>@L["CurrencyDefaultHint"]</p></div></div>
    <div class="form-grid two"><div class="form-group"><label asp-for="DefaultCurrencyCode">@L["DefaultCurrency"]</label><select asp-for="DefaultCurrencyCode" class="form-select" disabled="@(Model.DefaultCurrencyLocked ? "disabled" : null)">@foreach (var c in Model.Currencies){<option value="@c.Code">@c.Code — @c.Name</option>}</select>@if(Model.DefaultCurrencyLocked){<small class="text-muted">@L["CurrencyDefaultLocked"]</small>}<input asp-for="DefaultCurrencyCode" type="hidden" /></div><div class="form-group"><label>@L["Provider"]</label><select asp-for="ProviderKind" class="form-select"><option value="FrankfurterV2">Frankfurter v2</option></select></div></div>
    <div class="section-head mt-4"><div><h2>@L["RateProvider"]</h2><p>@L["CurrencyProviderHint"]</p></div></div>
    <div class="form-group"><label asp-for="BaseUrl">@L["BaseUrl"]</label><input asp-for="BaseUrl" class="form-control" /><span asp-validation-for="BaseUrl" class="text-danger"></span></div>
    <div class="form-grid two"><div class="form-group"><label asp-for="AuthenticationMode">@L["Authentication"]</label><select asp-for="AuthenticationMode" class="form-select"><option value="None">None</option><option value="Bearer">Bearer</option><option value="XApiKey">X-Api-Key</option></select></div><div class="form-group"><label asp-for="ApiKey">@L["ApiKeyOptional"]</label><input asp-for="ApiKey" class="form-control" autocomplete="new-password" placeholder="@(Model.HasStoredApiKey ? "••••••••" : "")" /><small class="text-muted">@L["EncryptedAtRest"]</small></div></div>
    <div class="form-check mt-3"><input asp-for="AllowPrivateNetworkEndpoint" class="form-check-input" /><label asp-for="AllowPrivateNetworkEndpoint" class="form-check-label">@L["AllowPrivateEndpoint"]</label></div>
    <div class="form-check mt-3"><input asp-for="AutoRefreshEnabled" class="form-check-input" /><label asp-for="AutoRefreshEnabled" class="form-check-label">@L["AutoRefresh"]</label></div>
    <div class="form-actions"><button class="btn btn-primary" type="submit">@L["SaveConfiguration"]</button></div>
</form>
<div class="content-card mt-3"><div class="section-head"><div><h2>@L["ConnectionTest"]</h2><p>@(Model.LastTestSucceeded == true ? L["ConnectionHealthy"] : Model.LastTestSucceeded == false ? L["ConnectionFailed"] : L["ConnectionNotTested"])</p></div><form asp-action="Test" method="post"><input type="hidden" asp-for="DefaultCurrencyCode" /><input type="hidden" asp-for="ProviderKind" /><input type="hidden" asp-for="BaseUrl" /><input type="hidden" asp-for="AuthenticationMode" /><input type="hidden" asp-for="ApiKey" /><input type="hidden" asp-for="AllowPrivateNetworkEndpoint" /><button class="btn btn-soft" type="submit">@L["TestConnection"]</button></form></div><form asp-action="Refresh" method="post" class="mt-3"><button class="btn btn-soft" type="submit">@L["RefreshNow"]</button></form>@if(Model.LastRefreshAt.HasValue){<small class="text-muted d-block mt-2">@L["LastRefresh"]: @Model.LastRefreshAt.Value.ToLocalTime()</small>}</div>
