<div class="receipt-modal" data-receipt-modal hidden role="dialog" aria-modal="true" aria-labelledby="receipt-modal-title">
    <div class="receipt-modal-backdrop" data-receipt-close></div>
    <div class="receipt-modal-panel" role="document">
        <div class="receipt-modal-header"><h2 id="receipt-modal-title">@L["ReceiptPhotos"]</h2><button type="button" class="receipt-modal-close" data-receipt-close aria-label='@L["CloseReceiptViewer"]'>×</button></div>
        <div class="receipt-modal-stage"><img data-receipt-image alt='@L["ReceiptPhotos"]' /></div>
        <div class="receipt-modal-controls"><button type="button" class="btn btn-soft" data-receipt-prev>@L["PreviousPhoto"]</button><span data-receipt-counter></span><button type="button" class="btn btn-soft" data-receipt-next>@L["NextPhoto"]</button></div>
        <div class="receipt-modal-zoom"><button type="button" class="btn btn-soft" data-receipt-zoom-out>@L["ZoomOut"]</button><span data-receipt-zoom-value>100%</span><button type="button" class="btn btn-soft" data-receipt-zoom-in>@L["ZoomIn"]</button><button type="button" class="btn btn-soft" data-receipt-zoom-reset>@L["ResetZoom"]</button></div>
    </div>
</div>
