@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> LayoutUsers
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#003A40" />
    <meta name="mobile-web-app-capable" content="yes" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <title>@ViewData["Title"] · SplitBill</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(User.Identity?.IsAuthenticated == true ? "app-shell" : "auth-shell")">
@if (User.Identity?.IsAuthenticated == true)
{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var canManage = User.IsInRole(DatabaseSeeder.AdminRole) || User.IsInRole(DatabaseSeeder.ModeratorRole);
    var isAdmin = User.IsInRole(DatabaseSeeder.AdminRole);
    var uploadWorkflowActive = currentController == "Transactions" && currentAction is "Upload" or "Review" or "Split";
    bool IsActive(string controller, string action) => controller switch
    {
        "Transactions" => currentController == controller && (action == "Upload" ? uploadWorkflowActive : !uploadWorkflowActive),
        "AdminMicrosoft" => currentController is "AdminMicrosoft" or "AdminSharePoint",
        "AccountSettings" => currentController == controller || (currentController == "Account" && currentAction == "ChangePassword"),
        _ => currentController == controller
    };
    var roleLabel = isAdmin ? "Admin" : canManage ? "Moderator" : "Member";
    var profileUser = await LayoutUsers.GetUserAsync(User);
    var profileUsername = profileUser?.UserName ?? User.Identity?.Name ?? string.Empty;
    var profileName = string.IsNullOrWhiteSpace(profileUser?.DisplayName) ? profileUsername : profileUser.DisplayName;
    var operations = new List<(string Controller, string Action, string Label, string Icon)> { ("Dashboard", "Index", "Dashboard", "dashboard") };
    if (canManage)
    {
        operations.Add(("Transactions", "Upload", "UploadReceipt", "upload"));
        operations.Add(("Transactions", "Index", "Transactions", "transactions"));
    }
    operations.Add(("Reports", "Index", "Report", "report"));
    if (canManage) { operations.Add(("Payments", "Approvals", "Approvals", "approvals")); }
    var personal = new[] { ("MyBills", "Index", "MyBills", "bills"), ("Notifications", "Index", "Notifications", "notifications") };
    var administration = new[] {
        ("AdminSettings", "Index", "AISettings", "settings"), ("AdminCurrency", "Index", "CurrencySettings", "currency"),
        ("AdminMicrosoft", "Index", "MicrosoftIntegration", "microsoft"), ("AdminUsers", "Index", "ManageUsers", "users"),
        ("AdminFoodPickup", "Index", "FoodPickupRotation", "pickup"), ("AdminSystem", "Index", "SystemTools", "system")
    };
    var primaryMobile = canManage
        ? new[] { ("Dashboard", "Index", "Dashboard", "dashboard"), ("Transactions", "Upload", "UploadReceipt", "upload"), ("Transactions", "Index", "Transactions", "transactions"), ("MyBills", "Index", "MyBills", "bills") }
        : new[] { ("Dashboard", "Index", "Dashboard", "dashboard"), ("MyBills", "Index", "MyBills", "bills"), ("Reports", "Index", "Report", "report") };
    var moreActive = !primaryMobile.Any(item => IsActive(item.Item1, item.Item2));
    <aside class="sidebar">
        <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">S</span><span>SplitBill</span></a>
        <partial name="_CultureSwitcher" />
        <nav class="side-nav" aria-label='@L["MainNavigation"]'>
            <div class="nav-label">@L["Operations"]</div>
            @foreach (var item in operations)
            {
                <a asp-controller="@item.Controller" asp-action="@item.Action" class="@(IsActive(item.Controller, item.Action) ? "active" : "")" aria-current="@(IsActive(item.Controller, item.Action) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model="item.Icon" /></span><span class="nav-text">@L[item.Label]</span></a>
            }
            <div class="nav-label">@L["Personal"]</div>
            @foreach (var item in personal)
            {
                <a asp-controller="@item.Item1" asp-action="@item.Item2" class="@(IsActive(item.Item1, item.Item2) ? "active" : "")" aria-current="@(IsActive(item.Item1, item.Item2) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model="item.Item4" /></span><span class="nav-text">@L[item.Item3]</span>@if(item.Item1 == "Notifications") { @await Component.InvokeAsync("NotificationBadge") }</a>
            }
            @if (isAdmin)
            {
                <div class="nav-label">@L["Administration"]</div>
                @foreach (var item in administration)
                {
                    <a asp-controller="@item.Item1" asp-action="@item.Item2" class="@(IsActive(item.Item1, item.Item2) ? "active" : "")" aria-current="@(IsActive(item.Item1, item.Item2) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model="item.Item4" /></span><span class="nav-text">@L[item.Item3]</span></a>
                }
            }
        </nav>
        <div class="sidebar-user">
            <span class="avatar">@(profileUsername.Length >= 2 ? profileUsername[..2].ToUpperInvariant() : profileUsername.Length == 1 ? profileUsername.ToUpperInvariant() : "U")</span>
            <div class="sidebar-user-info"><strong title="@profileName">@profileName</strong><small class="sidebar-username" title="@profileUsername">@@@profileUsername</small><small>@L[roleLabel]</small></div>
            <div class="sidebar-user-actions">
                <a asp-controller="AccountSettings" asp-action="Index" class="sidebar-account-settings" aria-label='@L["AccountSettings"]' title='@L["AccountSettings"]'><partial name="_SettingsIcon" /></a>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="sidebar-logout" type="submit" aria-label='@L["Logout"]' title='@L["Logout"]'><partial name="_LogoutIcon" /></button></form>
            </div>
        </div>
        <div class="sidebar-version" title="@AppVersion.Current.InformationalVersion">@AppVersion.Current.DisplayVersion</div>
    </aside>
    <header class="mobile-header">
        <a class="brand" asp-controller="Dashboard" asp-action="Index"><span class="brand-mark">S</span><span>SplitBill</span><small class="mobile-app-version">@AppVersion.Current.DisplayVersion</small></a>
        <div class="mobile-account"><partial name="_CultureSwitcher" /><a class="mobile-notification-link" asp-controller="Notifications" asp-action="Index" aria-label='@L["Notifications"]' title='@L["Notifications"]'><partial name="_BellIcon" />@await Component.InvokeAsync("NotificationBadge")</a><a asp-controller="AccountSettings" asp-action="Index" class="avatar" aria-label='@L["AccountSettings"]'><partial name="_SettingsIcon" /></a><form asp-controller="Account" asp-action="Logout" method="post"><button class="mobile-logout" type="submit" aria-label='@L["Logout"]'><span>@L["Logout"]</span> <partial name="_LogoutIcon" /></button></form></div>
    </header>
    <main class="main-content">
        <div class="pwa-install-banner" data-pwa-install-hint hidden><span>@L["InstallAppHint"]</span><button type="button" class="btn btn-soft" data-pwa-install>@L["InstallApp"]</button></div>
        <div class="pwa-install-banner" data-pwa-update-hint hidden><span>@L["UpdateAppHint"]</span><button type="button" class="btn btn-soft" data-pwa-update hidden>@L["RefreshApp"]</button></div>
        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success app-alert" role="alert">✓ @success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger app-alert" role="alert">! @error</div>
        }
        @RenderBody()
    </main>
    <nav class="bottom-nav" aria-label='@L["MainNavigation"]'>
        @foreach (var item in primaryMobile)
        {
            <a asp-controller="@item.Item1" asp-action="@item.Item2" class="@(IsActive(item.Item1, item.Item2) ? "active" : "")" aria-current="@(IsActive(item.Item1, item.Item2) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model="item.Item4" /></span><span class="nav-text">@L[item.Item3]</span></a>
        }
        <details class="bottom-more @(moreActive ? "active" : "")">
            <summary aria-controls="mobile-more-menu"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model='"menu"' /></span><span class="nav-text">@L["Menu"]</span></summary>
            <div id="mobile-more-menu" class="bottom-more-menu">
                @if (canManage)
                {
                    <div class="bottom-more-label">@L["Operations"]</div>
                    @foreach (var item in operations.Where(item => item.Controller is "Reports" or "Payments"))
                    {
                        <a asp-controller="@item.Controller" asp-action="@item.Action" class="@(IsActive(item.Controller, item.Action) ? "active" : "")" aria-current="@(IsActive(item.Controller, item.Action) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model="item.Icon" /></span><span>@L[item.Label]</span></a>
                    }
                }
                <div class="bottom-more-label">@L["Personal"]</div>
                <a asp-controller="Notifications" asp-action="Index" class="@(currentController == "Notifications" ? "active" : "")" aria-current="@(currentController == "Notifications" ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model='"notifications"' /></span><span>@L["Notifications"]</span>@await Component.InvokeAsync("NotificationBadge")</a>
                <a asp-controller="AccountSettings" asp-action="Index" class="@(IsActive("AccountSettings", "Index") ? "active" : "")" aria-current="@(IsActive("AccountSettings", "Index") ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_SettingsIcon" /></span><span>@L["AccountSettings"]</span></a>
                @if (isAdmin)
                {
                    <div class="bottom-more-label">@L["Administration"]</div>
                    @foreach (var item in administration)
                    {
                        <a asp-controller="@item.Item1" asp-action="@item.Item2" class="@(IsActive(item.Item1, item.Item2) ? "active" : "")" aria-current="@(IsActive(item.Item1, item.Item2) ? "page" : null)"><span class="nav-icon" aria-hidden="true"><partial name="_NavIcon" model="item.Item4" /></span><span>@L[item.Item3]</span></a>
                    }
                }
            </div>
        </details>
    </nav>
}
else
{
    <partial name="_CultureSwitcher" /><main>@RenderBody()</main>
}
<partial name="_ReceiptModal" />
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    window.splitBillStrings = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new {
        duplicateUser = L["DuplicateUser"].Value,
        duplicateParticipant = L["DuplicateParticipant"].Value,
        chooseParticipant = L["ChooseAtLeastOneParticipant"].Value,
        chooseItemParticipant = L["ChooseItemParticipant"].Value,
        rateFromAmount = L["RateFromAmount"].Value,
        selectedPhotos = L["SelectedPhotos"].Value,
        photoNumber = L["PhotoNumber"].Value,
        removePhoto = L["DeleteDraft"].Value,
        rejectReason = L["RejectReasonPrompt"].Value,
        deleteDraftConfirm = L["DeleteDraftConfirm"].Value,
        markPaidConfirm = L["MarkPaidConfirm"].Value,
        chooseModel = L["ChooseModel"].Value,
        azureFieldsRequired = L["AzureFieldsRequired"].Value,
        loadingModels = L["LoadingModels"].Value,
        modelsLoadFailed = L["ModelsLoadFailed"].Value,
        modelsAvailable = L["ModelsAvailable"].Value,
        storedModel = L["StoredModel"].Value,
        azureConnectionHint = L["AzureConnectionHint"].Value,
        openAiModelHint = L["OpenAiModelHint"].Value,
        remove = L["Remove"].Value,
        accountSuffix = L["AccountSuffix"].Value,
        guestSuffix = L["GuestSuffix"].Value,
        effectiveRate = L["EffectiveRate"].Value,
        receiptPhotoCounter = L["ReceiptPhotoCounter"].Value,
        receiptPhotos = L["ReceiptPhotos"].Value,
        paymentProof = L["PaymentProof"].Value
        ,shareRendering = L["ShareRendering"].Value
        ,shareReady = L["ShareReady"].Value
        ,shareFallback = L["ShareFallback"].Value
        ,shareError = L["ShareError"].Value
        ,shareTooTall = L["ShareTooTall"].Value
        ,shareSelectParticipant = L["ShareSelectParticipant"].Value
    }));
</script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script src="~/js/transaction-share.js" asp-append-version="true"></script>
<script src="~/js/share-actions.js" asp-append-version="true"></script>
<script src="~/js/pwa.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
